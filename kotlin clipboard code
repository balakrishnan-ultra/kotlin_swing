import java.awt.*
import java.awt.event.ActionEvent
import java.awt.event.ActionListener
import javax.swing.*

class ClipboardDemo : JFrame("Clipboard Demo") {

    private val textField = JTextField(20)
    private val copyButton = JButton("Copy")
    private val pasteButton = JButton("Paste")

    init {
        defaultCloseOperation = JFrame.EXIT_ON_CLOSE
        layout = FlowLayout()

        add(textField)
        add(copyButton)
        add(pasteButton)

        copyButton.addActionListener(object : ActionListener {
            override fun actionPerformed(e: ActionEvent?) {
                val textToCopy = textField.text
                copyToClipboardSwing(textToCopy)
            }
        })

        pasteButton.addActionListener(object : ActionListener {
            override fun actionPerformed(e: ActionEvent?) {
                val pastedText = pasteFromClipboardSwing()
                if (pastedText != null) {
                    textField.text = pastedText
                } else {
                    JOptionPane.showMessageDialog(this@ClipboardDemo, "Clipboard is empty or does not contain text.", "Paste Error", JOptionPane.ERROR_MESSAGE)
                }
            }
        })

        pack()
        isVisible = true
    }
}

fun main() {
    EventQueue.invokeLater {
        ClipboardDemo()
    }
}

